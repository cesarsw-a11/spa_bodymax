datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int        @id @default(autoincrement())
  name        String
  email       String     @unique
  password    String
  role        Role       @default(USER)
  adminRoleId Int?
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([adminRoleId])
}

enum Role {
  USER
  ADMIN
}

model AdminRole {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  permissionsJson String   @db.LongText
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String    @db.Text
  /** Inglés (opcional). Si falta, en /en se usa name/description. */
  nameEn        String?
  descriptionEn String?   @db.Text
  imageUrl    String?
  /** Legacy: sincronizado con la primera variante; la reserva usa ServiceVariant. */
  price       Decimal   @db.Decimal(10,2)
  /** Legacy: duración (min) de la primera variante; la reserva usa ServiceVariant. */
  durationMin Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  variants    ServiceVariant[]
  giftCards   GiftCardOrder[]
}

model ServiceVariant {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  durationMin Int
  price       Decimal  @db.Decimal(10, 2)
  label       String?  @db.VarChar(191)
  labelEn     String?  @db.VarChar(191)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  giftCards   GiftCardOrder[]

  @@index([serviceId])
}

model Addon {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id                     Int       @id @default(autoincrement())
  customer               String
  phone                  String
  email                  String?
  serviceId              Int
  serviceVariantId       Int?
  date                   DateTime  // fecha con hora de inicio
  endDate                DateTime  // hora fin calculada
  price                  Decimal   @db.Decimal(10,2)
  status                 BookingStatus @default(PENDING)
  notes                  String?
  addonsJson             String?   @db.LongText // JSON serializado: ids de complementos, ej. "[1,2]"
  stripePaymentIntentId  String?   @db.VarChar(255) // para reembolsos vía Stripe al cancelar
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  service                Service   @relation(fields: [serviceId], references: [id])
  serviceVariant         ServiceVariant? @relation(fields: [serviceVariantId], references: [id])
  redeemedGiftCard       GiftCardOrder?  @relation("GiftCardRedemption")

  @@index([serviceVariantId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TestimonialSource {
  GOOGLE
  INSTAGRAM
  FACEBOOK
}

model Testimonial {
  id        Int               @id @default(autoincrement())
  quote     String            @db.Text
  /** Inglés (opcional). En /en se usa si está relleno; si no, `quote`. */
  quoteEn   String?           @db.Text
  author    String?           @db.VarChar(191)
  source    TestimonialSource
  sourceUrl String?           @db.VarChar(512)
  sortOrder Int               @default(0)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model BlockedSlot {
  id        Int      @id @default(autoincrement())
  start     DateTime
  end       DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GiftCardOrder {
  id                      Int               @id @default(autoincrement())
  status                  GiftCardStatus    @default(PENDING)
  amount                  Decimal           @db.Decimal(10, 2)
  currency                String            @default("mxn") @db.VarChar(8)

  serviceId               Int
  serviceVariantId        Int?
  serviceNameSnapshot     String            @db.VarChar(191)
  serviceNameEnSnapshot   String?           @db.VarChar(191)
  variantLabelSnapshot    String?           @db.VarChar(191)
  variantLabelEnSnapshot  String?           @db.VarChar(191)
  variantDurationSnapshot Int?

  recipientName           String            @db.VarChar(120)
  senderName              String            @db.VarChar(120)
  senderEmail             String?           @db.VarChar(191)
  message                 String?           @db.Text

  redeemCode              String            @unique @db.VarChar(32)

  stripeCheckoutSessionId String?           @db.VarChar(255)
  stripePaymentIntentId   String?           @db.VarChar(255)

  redeemedAt              DateTime?
  redeemedBookingId       Int?              @unique

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  service                 Service           @relation(fields: [serviceId], references: [id])
  serviceVariant          ServiceVariant?   @relation(fields: [serviceVariantId], references: [id])
  redeemedBooking         Booking?          @relation("GiftCardRedemption", fields: [redeemedBookingId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([serviceVariantId])
  @@index([status])
  @@index([redeemedAt])
}

enum GiftCardStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
